<!--
  The XML theme now carries the same Orbit values as AppAppearance.ORBIT.

  It used to hold the old green-grey palette (#A4D8BB on #101411) while the Kotlin
  UI drew the approved dark-glass + neon look. Anything the framework paints for
  us — the pre-inflate splash window, AlertDialogs, edit-text handles, ripple
  defaults — used those stale colours, so the app flashed a different green on
  launch and dialogs came up in a palette that no longer exists anywhere else.

  Parent is DarkActionBar-free *Dark*, not DayNight: the layout is designed for a
  dark canvas only, and DayNight let a phone in light mode hand the dialogs white
  surfaces with near-white text on them.
-->
<resources>
    <style name="Theme.KouroshAe" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- mint / neon accents, straight from the approved mock -->
        <item name="colorPrimary">#F6D98B</item>
        <item name="colorOnPrimary">#050505</item>
        <item name="colorSecondary">#22D3C5</item>
        <item name="colorError">#B3372F</item>
        <!-- void / raised / recessed surfaces -->
        <item name="android:colorBackground">#050505</item>
        <item name="colorSurface">#0B0A08</item>
        <item name="colorOnSurface">#F3E6C4</item>
        <item name="colorSurfaceVariant">#12100C</item>
        <item name="colorOnSurfaceVariant">#A89870</item>
        <item name="colorOutline">#5B4522</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:statusBarColor">#050505</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KouroshAe.AlertDialog</item>
   </style>

    <!--
      The window the system shows before onCreate finishes. Same void background
      as the canvas, so launching the app does not flash a lighter panel before
      the Orbit console appears.
    -->
    <style name="Theme.KouroshAe.Starting" parent="Theme.KouroshAe">
        <item name="android:windowBackground">#050505</item>
   </style>

    <!--
      Invisible, non-animating window used only to collapse the Quick Settings
      shade (see ShadeCollapseActivity). It must never paint anything: a normal
      theme would flash the void background over whatever is behind the shade.
    -->
    <style name="Theme.KouroshAe.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
   </style>

    <style name="ThemeOverlay.KouroshAe.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KouroshAe.Dialog</item>
        <item name="colorSurface">#0B0A08</item>
        <item name="colorOnSurface">#F3E6C4</item>
        <item name="colorPrimary">#F6D98B</item>
   </style>

    <style name="ShapeAppearance.KouroshAe.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">28dp</item>
   </style>

    <!--
      Porcelain: the light half of the theme switch.

      This is a second explicit theme, NOT a values-night/ split. The palette is
      the user's choice inside the app, not the phone's night setting, so a
      resource qualifier would pick the wrong one whenever the two disagree.
      MainActivity applies whichever of these matches AppAppearance.mode()
      before super.onCreate().

      Values mirror AppAppearance.PORCELAIN exactly. Anything the framework
      paints for us — dialogs, edit-text handles, ripple defaults, the pre-inflate
      window — reads from here, and a mismatch here is how a white app ends up
      with one black dialog.
    -->
    <style name="Theme.KouroshAe.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">#0E9C82</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#6B5BD6</item>
        <item name="colorError">#B3261E</item>
        <item name="android:colorBackground">#EEF1F4</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111A1F</item>
        <item name="colorSurfaceVariant">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#4E6069</item>
        <item name="colorOutline">#E0E6EA</item>
        <item name="android:navigationBarColor">#EEF1F4</item>
        <item name="android:statusBarColor">#EEF1F4</item>
        <!-- Dark icons in the bars: the bars are now near-white. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KouroshAe.Light.AlertDialog</item>
   </style>

    <style name="ThemeOverlay.KouroshAe.Light.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KouroshAe.Dialog</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111A1F</item>
        <item name="colorPrimary">#087060</item>
   </style>
</resources>
